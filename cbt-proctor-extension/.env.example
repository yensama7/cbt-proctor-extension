# Copy to .env and edit before `docker compose up`.
# The server refuses to start in production with the default admin password.

ADMIN_USER=admin
ADMIN_PASS=change-me-before-deploying

# Generate with: openssl rand -hex 32
# Keeps admin tokens valid across server restarts.
TOKEN_SECRET=

# Optional: lock CORS to the public origin (default: *)
# CORS_ORIGIN=https://cbt.campus.edu
