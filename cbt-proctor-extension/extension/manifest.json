{
  "manifest_version": 3,
  "name": "CBT Proctor Agent",
  "version": "2.1",
  "description": "Host-based malpractice detection agent for CBT",
  "incognito": "split",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/exam/*",
        "http://127.0.0.1:3000/exam/*",
        "http://*/exam/*",
        "https://*/exam/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}